# Kerflow backend — reference of every environment variable.
# Spring Boot reads these from the environment, not from a file: export the ones you need
# (e.g. `set -a; source .env; set +a`) before ./gradlew bootRun.
# All of them are OPTIONAL: the dev profile boots with every integration disabled.

# --- AWS Cognito (authentication) -------------------------------------------
# Required to sign up / sign in. Without it the app starts but /v1/authentication fails.
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_ACCESS_KEY_SECRET=
SPRING_COGNITO_USER_POOL_ID=
SPRING_COGNITO_CLIENT_ID=
SPRING_COGNITO_CLIENT_SECRET=

# --- Google Places (prospect search & enrichment) ---------------------------
# Without it, /v1/search returns no result.
GOOGLE_PLACES_API_KEY=

# --- Recherche d'Entreprises (French open data, no key needed) --------------
RECHERCHE_ENTREPRISES_BASE_URL=https://recherche-entreprises.api.gouv.fr

# --- Stripe (billing) -------------------------------------------------------
STRIPE_API_KEY=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_ANNUAL=

# --- Resend (transactional email) -------------------------------------------
# Leave empty to keep DummyResendService, which only logs.
RESEND_API_KEY=
MAIL_FROM=Kerflow <contact@example.com>
# Postal address printed in the email footer. Yours, not ours; empty hides the line.
MAIL_POSTAL_ADDRESS=

# --- Discord (internal notifications) ---------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Sentry (error tracking) ------------------------------------------------
# SENTRY_AUTH_TOKEN / SENTRY_ORG are build-time only (source-context upload).
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=kerflow-backend

# --- Application ------------------------------------------------------------
# Comma-separated list of logins allowed to impersonate and reach admin endpoints.
# Empty means nobody is super-admin.
SUPER_ADMIN_EMAILS=
WEB_URL=http://localhost:5190
BACKEND_URL=http://localhost:8090
ALLOWED_ORIGIN=http://localhost:5190
