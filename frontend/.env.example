# Copy to .env and adjust. Every variable is optional: with an empty file the
# app talks to the backend on the same host and every integration stays off.
#
# Vite reads these at BUILD time and inlines them into the bundle. This file
# only covers local development: a production image gets the same names as
# Docker build arguments (see the Configuration section of the root README),
# and setting them on a running container has no effect.
#
# Whatever they are stored in upstream, the values end up readable in the
# JavaScript served to every browser. Never put an actual secret here.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Full base URL of the Kerflow backend. When empty the app derives it from the
# current window location (useful when both are served from the same domain).
VITE_BACKEND_URL=http://localhost:8090

# Port to use when VITE_BACKEND_URL is empty. Ignored otherwise.
VITE_BACKEND_PORT=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# 'true' loads the PostHog plugin. Also needs VITE_POSTHOG_KEY to do anything.
VITE_POSTHOG_ENABLED=false
# Your own PostHog project key. Never reuse someone else's.
VITE_POSTHOG_KEY=
# Defaults to https://eu.i.posthog.com
VITE_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Legal (optional)
# ---------------------------------------------------------------------------
# The terms of service belong to whoever operates the instance, so they are not
# shipped with the code. Point this at your own page; when empty, the links to
# the terms are not rendered at all.
VITE_TERMS_URL=
