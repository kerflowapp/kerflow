{
	"name": "kerflow-frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Vuetify web client for Kerflow, an agentic local-prospecting engine",
	"license": "AGPL-3.0-only",
	"author": "Fabien Battais",
	"homepage": "https://github.com/kerflowappp/kerflow#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kerflowappp/kerflow.git",
		"directory": "frontend"
	},
	"bugs": {
		"url": "https://github.com/kerflowappp/kerflow/issues"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"dev": "vite --port 5190 --host --mode dev",
		"build": "vite build",
		"build-with-types": "run-p type-check \"build-only {@}\" --",
		"build-only": "vite build",
		"type-check": "vue-tsc --build --force",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint . --fix",
		"format": "prettier --write src/",
		"generate:og": "bash scripts/og/generate-og.sh"
	},
	"dependencies": {
		"@capacitor/core": "^8.5.1",
		"@capacitor/preferences": "^8.0.1",
		"@date-io/date-fns": "^3.2.1",
		"@date-io/dayjs": "^3.2.0",
		"@mdi/font": "^7.4.47",
		"@vue-leaflet/vue-leaflet": "^0.10.1",
		"@vueuse/core": "^14.4.0",
		"axios": "^1.20.0",
		"axios-observable": "^2.1.0",
		"chart.js": "^4.5.1",
		"date-fns": "^4.4.0",
		"dompurify": "^3.4.14",
		"echarts": "^6.1.0",
		"heic-to": "^1.5.2",
		"leaflet": "^1.9.4",
		"marked": "^18.0.11",
		"pinia": "^4.0.3",
		"posthog-js": "^1.426.3",
		"rxjs": "^7.8.2",
		"uuid": "^14.0.2",
		"vue": "^3.5.42",
		"vue-echarts": "^8.2.0",
		"vue-i18n": "^11.4.10",
		"vue-router": "^5.3.1",
		"vuedraggable": "^4.1.0",
		"vuetify": "^4.2.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@tsconfig/node24": "^24.0.5",
		"@types/jsdom": "^30.0.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^24.13.3",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vitejs/plugin-vue-jsx": "^5.1.6",
		"@vitest/eslint-plugin": "^1.6.27",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.5.0",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.10.0",
		"globals": "^17.12.0",
		"jsdom": "^30.0.1",
		"npm-run-all2": "^9.0.3",
		"prettier": "^3.9.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^5.0.0",
		"vue-tsc": "^3.3.11"
	}
}
