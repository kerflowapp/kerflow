{
	"name": "kerflow-frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Vuetify web client for Kerflow, an agentic local-prospecting engine",
	"license": "AGPL-3.0-only",
	"author": "Fabien Battais",
	"homepage": "https://github.com/kerflowappp/kerflow#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kerflowappp/kerflow.git",
		"directory": "frontend"
	},
	"bugs": {
		"url": "https://github.com/kerflowappp/kerflow/issues"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "vite --port 5190 --host --mode dev",
		"build": "vite build",
		"build-with-types": "run-p type-check \"build-only {@}\" --",
		"build-only": "vite build",
		"type-check": "vue-tsc --build --force",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint . --fix",
		"format": "prettier --write src/",
		"generate:og": "bash scripts/og/generate-og.sh"
	},
	"dependencies": {
		"@capacitor/core": "^7.4.4",
		"@capacitor/preferences": "^7.0.2",
		"@date-io/date-fns": "^3.0.0",
		"@date-io/dayjs": "^3.0.0",
		"@mdi/font": "^7.4.47",
		"@vue-leaflet/vue-leaflet": "^0.10.1",
		"@vueuse/core": "^11.1.0",
		"axios": "^1.12.0",
		"axios-observable": "^2.0.0",
		"chart.js": "^4.4.1",
		"date-fns": "^3.3.1",
		"dompurify": "^3.4.12",
		"echarts": "^5.6.0",
		"heic-to": "^1.4.2",
		"leaflet": "^1.9.4",
		"marked": "^18.0.6",
		"pinia": "^2.2.4",
		"posthog-js": "^1.259.0",
		"rxjs": "^7.8.1",
		"uuid": "^11.1.0",
		"vue": "^3.5.11",
		"vue-echarts": "^7.0.3",
		"vue-i18n": "^11.1.10",
		"vue-router": "^4.4.5",
		"vuedraggable": "^4.1.0",
		"vuetify": "^3.7.6",
		"vuetify-sonner": "^0.3.21"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.0",
		"@eslint/js": "^10.0.1",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@tsconfig/node20": "^20.1.4",
		"@types/jsdom": "^21.1.7",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^20.16.11",
		"@vitejs/plugin-vue": "^5.1.4",
		"@vitejs/plugin-vue-jsx": "^4.0.1",
		"@vitest/eslint-plugin": "1.1.7",
		"@vue/eslint-config-prettier": "^10.0.0",
		"@vue/eslint-config-typescript": "^14.0.0",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.5.1",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-vue": "^9.29.0",
		"globals": "^15.14.0",
		"jsdom": "^25.0.1",
		"npm-run-all2": "^6.2.3",
		"prettier": "^3.5.3",
		"typescript": "~5.5.4",
		"typescript-eslint": "^8.18.0",
		"vite": "^5.4.8",
		"vitest": "^2.1.2",
		"vue-tsc": "^2.1.6"
	}
}
